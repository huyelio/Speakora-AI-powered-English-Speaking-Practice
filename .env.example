# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Pronunciation/Vocabulary word samples use the clearer recommended voice.
OPENAI_VOCAB_TTS_VOICE=marin
OPENAI_VOCAB_TTS_SPEED=1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_ASSESSMENT_MODEL=gpt-5.4-mini
# AI role-play replies; a fast model keeps the chat responsive.
OPENAI_CONVERSATION_MODEL=gpt-5.4-nano
WORKER_POLL_MS=1500
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Supabase Data API. Keep these names aligned with the project dashboard.
PROJECT_URL=https://your-project-ref.supabase.co
PUBLISHABLE_KEY=

# Canonical application URL for Auth email redirects. Use HTTPS outside local development.
APP_URL=http://localhost:3000

# Server-only elevated key. Never expose it to client components or the browser.
SECRET_KEY=

# Optional: only needed by migration/CLI tools that connect directly to Postgres.
SUPABASE_PASSWORD=
SUPABASE_API_URL=
# Question CSV import:
# npm run questions:check
# npm run questions:import -- raw_data
