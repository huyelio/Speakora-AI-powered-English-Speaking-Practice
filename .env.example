# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Supabase Data API. Keep these names aligned with the project dashboard.
PROJECT_URL=https://your-project-ref.supabase.co
PUBLISHABLE_KEY=

# Server-only elevated key. Never expose it to client components or the browser.
SECRET_KEY=

# Optional: only needed by migration/CLI tools that connect directly to Postgres.
SUPABASE_PASSWORD=
SUPABASE_API_URL=

# Question CSV import:
# npm run questions:check
# npm run questions:import -- raw_data
