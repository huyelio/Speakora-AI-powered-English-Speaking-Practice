# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Optional vocabulary-only overrides (defaults keep coral / 0.9 speed)
# OPENAI_VOCAB_TTS_VOICE=nova
# OPENAI_VOCAB_TTS_SPEED=0.9
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_ASSESSMENT_MODEL=gpt-4o-mini
WORKER_POLL_MS=1500

# Supabase Data API. Keep these names aligned with the project dashboard.
PROJECT_URL=https://your-project-ref.supabase.co
PUBLISHABLE_KEY=

# Canonical application URL for Auth email redirects. Use HTTPS outside local development.
APP_URL=http://localhost:3000

# Server-only elevated key. Never expose it to client components or the browser.
SECRET_KEY=

# Optional: only needed by migration/CLI tools that connect directly to Postgres.
SUPABASE_PASSWORD=
SUPABASE_API_URL=

# Question CSV import:
# npm run questions:check
# npm run questions:import -- raw_data
